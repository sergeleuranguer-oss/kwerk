ErrorDocument 404 /index.html
ErrorDocument 403 /index.html

RewriteEngine On
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^espaces/haussmann/?$ /adresses/haussmann.html [R=301,L]
RewriteRule ^espaces/messine/?$ /adresses/messine.html [R=301,L]
RewriteRule ^espaces/madeleine/?$ /adresses/madeleine.html [R=301,L]
RewriteRule ^espaces/saint-honore/?$ /adresses/saint-honore.html [R=301,L]

RewriteRule ^adresses/haussmann/?$ /adresses/haussmann.html [R=301,L]
RewriteRule ^adresses/messine/?$ /adresses/messine.html [R=301,L]
RewriteRule ^adresses/madeleine/?$ /adresses/madeleine.html [R=301,L]
RewriteRule ^adresses/saint-honore/?$ /adresses/saint-honore.html [R=301,L]

RewriteRule ^adresses/?$ /maison-kwerk.html [R=301,L]

RewriteRule ^services/?$ /espaces.html [R=301,L]
RewriteRule ^espaces/?$ /espaces.html [R=301,L]
RewriteRule ^event/?$ /event.html [R=301,L]

RewriteRule ^en/services/?$ /en/espaces.html [R=301,L]
RewriteRule ^en/espaces/?$ /en/espaces.html [R=301,L]
RewriteRule ^en/event/?$ /en/event.html [R=301,L]
RewriteRule ^en/galerie/?$ /en/galerie.html [R=301,L]
